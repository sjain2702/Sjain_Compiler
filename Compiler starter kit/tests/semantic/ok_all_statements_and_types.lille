-- Exercises every statement kind and the type rules (real/int mixing, booleans, strings, constants).
program everything is
  i : integer;
  r : real := 1;
  s : string := "hi";
  b : boolean;
  neg : constant integer := -4;
begin
  i := 7;
  r := r + i * 2.0;
  b := (i > 3) and not (r < 0.5);
  b := i in 1 .. 10;
  s := s & " there" & int2string(i);
  read(i);
  while i > 0 loop
    i := i - 1;
    exit when i = 2;
  end loop;
  loop
    exit;
  end loop;
  for k in reverse 1 .. 3 loop
    write k;
  end loop;
  if b then null; elsif i = 1 then null; else null; end if;
  writeln;
end everything;
